# --- Ollama Cloud (modelo de geracao e embeddings) ---
OLLAMA_API_KEY=SUA_CHAVE_AQUI
OLLAMA_BASE_URL=https://ollama.com

OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_MODEL_2=gpt-oss:20b-cloud

# --- Sprint 03 (chatbot LCEL) ---
TEMPERATURE=0.1
TOP_P=0.9
MAX_TOKENS=512
MAX_HISTORY_TOKENS=2000

# --- Sprint 04 (RAG) ---
RAG_MIN_SCORE=0.62
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text

RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=gpt-oss:120b-cloud
RAG_PROMPT_VERSION=v3
RAG_TEMPERATURE=0
RAG_TOP_P=0.9
RAG_MAX_TOKENS=1024

RAG_K=6
# Rode scripts/calibrar_limiar.py e ajuste este valor
RAG_MIN_SCORE=0.55
RAG_HIBRIDO=1

RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_MODO=secao

# Bonus multi-provider (so se for usar)
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
