# --- Ollama Cloud (modelo de geracao) ---
OLLAMA_API_KEY=SUA_CHAVE_AQUI
OLLAMA_BASE_URL=https://ollama.com

OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_MODEL_2=gpt-oss:20b-cloud

# --- Sprint 03 (chatbot LCEL) ---
TEMPERATURE=0.1
TOP_P=0.9
MAX_TOKENS=512
MAX_HISTORY_TOKENS=2000

# --- Sprint 04 (RAG) ---
# Embeddings no Ollama LOCAL (rode: ollama pull nomic-embed-text). A Ollama Cloud pode recusar /api/embed (401).
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_BASE_URL=http://localhost:11434

RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=gpt-oss:120b-cloud
RAG_PROMPT_VERSION=v3
RAG_TEMPERATURE=0
RAG_TOP_P=0.9
RAG_MAX_TOKENS=1024

# Configuracao final medida na Sprint 04 (iteracao 6): busca hibrida, k=6, corte 0.55
RAG_HIBRIDO=1
RAG_K=6
# Com nomic-embed-text os scores ficam entre ~0.58 e 0.76; o corte so barra o que e muito distante
RAG_MIN_SCORE=0.55

RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_MODO=secao

# Bonus multi-provider (so se for usar)
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
